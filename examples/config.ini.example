# Copy to ~/.config/check-uoa-mail/config.ini and edit.
# Everything here is optional except [notify] recipient.

[notify]
# Where every notification is forwarded. Required.
# Can also be supplied as the UOA_RECIPIENT environment variable.
recipient = you@example.com

[imap]
host = mail.uoa.gr
port = 993
mailbox = INBOX
timeout = 20

[smtp]
# mail.uoa.gr refuses submission; smtp.uoa.gr accepts it.
host = smtp.uoa.gr
port = 465
mode = ssl
# Leave blank to use "<username>@uoa.gr" from your credentials file.
from =
timeout = 25

[deadlines]
urgent_days = 3
week_days = 7
horizon_days = 365

[eclass]
base = https://eclass.uoa.gr
sso = https://sso.uoa.gr
timeout = 30

[agent]
# Gmail, Google Calendar, Google Drive and Trello are reached over MCP rather
# than through their own API clients, by handing a single-shot prompt to an
# assistant CLI that already holds the OAuth grants for those accounts.
#
# cli         the command to run, as it appears on PATH
# mcp_prefix  the prefix its connector tool ids share, so that a connector
#             named Gmail with a tool named get_message resolves to
#             <mcp_prefix>Gmail__get_message
#
# Both are blank by default and no vendor name ships in the source. Leave
# them blank and every MCP-backed step is skipped: notifications, deadline
# parsing, the ledger and the local briefs all keep working, while Calendar
# events, Trello cards, Drive filing and cross-device read sync do not.
# They can also be supplied as UOA_AGENT_CLI and UOA_MCP_PREFIX.
cli =
mcp_prefix =
timeout = 180
